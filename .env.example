# Server
PORT=3001
NODE_ENV=production

# CORS — set to a specific origin in production (default "*" is public read-only)
CORS_ORIGIN=*

# Logging level: error | warn | info | debug
LOG_LEVEL=info

# FlareSolverr (Cloudflare bypass). Enable to route protected providers through it.
USE_FLARESOLVERR=true
FLARESOLVERR_URL=http://flaresolverr:8191/v1

# Per-provider hard timeout inside a combo search (ms)
PROVIDER_TIMEOUT=8000

# Circuit breaker: open after N consecutive failures, retry after cooldown (ms)
CB_FAILURE_THRESHOLD=5
CB_COOLDOWN_MS=60000
